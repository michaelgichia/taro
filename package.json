{
  "name": "@tayo-dev/rtl",
  "version": "1.4.1",
  "description": "Generate high-quality React Testing Library tests from Recorder exports",
  "type": "module",
  "bin": {
    "tayo": "bin/install.js"
  },
  "files": [
    "dist",
    "agents",
    "assets",
    "bin",
    "commands",
    "docs",
    "taro",
    "hooks",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-hooks.js && tsc",
    "build:claude": "npm run build && node scripts/build-claude.js",
    "build:codex": "npm run build && node scripts/build-codex.js",
    "start": "node bin/install.js",
    "dev": "tsc && node dist/index.js",
    "pack:check": "npm pack --json --dry-run",
    "test": "node scripts/run-tests.cjs",
    "test:run": "node scripts/run-tests.cjs run",
    "test:coverage": "node scripts/run-tests.cjs run --coverage"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelgichia/tayo.git"
  },
  "homepage": "https://github.com/michaelgichia/tayo#readme",
  "bugs": {
    "url": "https://github.com/michaelgichia/tayo/issues"
  },
  "keywords": [
    "testing",
    "react-testing-library",
    "testing-library-recorder",
    "chrome-recorder",
    "code-generation"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/template": "^7.28.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "commander": "^12.0.0",
    "picocolors": "^1.0.0",
    "playwright": "^1.58.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/typescript-estree": "^8.56.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
