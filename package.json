{
  "name": "@tayo-dev/rtl",
  "version": "1.0.0",
  "description": "Generate high-quality React Testing Library tests from Chrome Recorder recordings",
  "type": "module",
  "bin": {
    "taro": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "pack:check": "npm pack --json --dry-run",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "testing",
    "react-testing-library",
    "chrome-recorder",
    "code-generation"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/template": "^7.28.0",
    "@babel/traverse": "^7.29.0",
    "commander": "^12.0.0",
    "picocolors": "^1.0.0",
    "playwright": "^1.58.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/typescript-estree": "^8.56.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
