{
  "name": "@taro-test/rtl",
  "version": "1.5.1",
  "description": "Generate high-quality React Testing Library tests from Recorder exports",
  "type": "module",
  "bin": {
    "taro": "bin/install.js"
  },
  "files": [
    "dist",
    "agents",
    "assets",
    "bin",
    "commands",
    "docs",
    "taro",
    "hooks",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-hooks.js && tsc -p tsconfig.build.json",
    "build:claude": "pnpm run build && node scripts/build-claude.js",
    "build:codex": "pnpm run build && node scripts/build-codex.js",
    "changelog": "node scripts/generate-changelog.cjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:sort-imports": "eslint . --fix",
    "lint:unused": "eslint . --fix --config eslint.unused.config.mjs",
    "start": "node bin/install.js",
    "dev": "tsc -p tsconfig.build.json && node dist/index.js",
    "pack:check": "pnpm pack --json --dry-run",
    "typecheck": "tsc -p tsconfig.json",
    "type-check": "pnpm run typecheck",
    "test": "node scripts/run-tests.cjs",
    "test:run": "node scripts/run-tests.cjs run",
    "test:coverage": "node scripts/run-tests.cjs run --coverage"
  },
  "imports": {
    "#*.ts": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelgichia/taro.git"
  },
  "homepage": "https://github.com/michaelgichia/taro#readme",
  "bugs": {
    "url": "https://github.com/michaelgichia/taro/issues"
  },
  "keywords": [
    "testing",
    "react-testing-library",
    "testing-library-recorder",
    "chrome-recorder",
    "code-generation"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/template": "^7.28.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^12.0.0",
    "picocolors": "^1.0.0",
    "playwright": "^1.58.2",
    "xstate": "^5.28.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "@typescript-eslint/typescript-estree": "^8.56.1",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
