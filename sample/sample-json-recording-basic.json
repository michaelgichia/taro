{
  "title": "JSON basic sale flow",
  "settings": { "url": "http://localhost:3000/sales" },
  "steps": [
    { "type": "navigate", "url": "http://localhost:3000/sales" },
    { "type": "click", "target": "Add Sale" },
    { "type": "assertElementVisible", "target": "Add Sale" },
    { "type": "fill", "target": "Customer Name", "value": "Acme Ltd" },
    { "type": "fill", "target": "Amount", "value": "1200" },
    { "type": "click", "target": "Submit Sale" },
    { "type": "assertElementVisible", "target": "Sale created" }
  ]
}
