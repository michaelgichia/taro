{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/fonts": ["./src/utils/fonts"],
      "public": ["./public"],
      "public/*": ["./public/*"],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "jest",
    "jest.config.mjs",
    "src/utils/salesiq.js",
    "src/providers/googleTagProvider.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "sample",
    "tests",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
